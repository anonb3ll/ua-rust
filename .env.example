# Copy to .env for local development. Every value here is a placeholder.
UA_HOME=~/.ua-rust
UA_WORKSPACE=~/projects
# UA_VAULT_PATH=~/notes
UA_BIND=127.0.0.1:8765
UA_ENFORCE_AUTH=true
# label:token pairs, comma separated, or a path to a file of such lines.
UA_AGENT_TOKENS=builder-1:replace-with-a-long-random-token,reviewer-1:replace-with-another-token
UA_HUMAN_IDENTITIES=operator
